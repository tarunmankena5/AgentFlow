# Copy to .env and fill in. Never commit .env.
DB_NAME=agentflow
DB_USERNAME=agentflow
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Generate a random value of at least 32 bytes, for example: openssl rand -base64 48
JWT_SECRET=
# Optional live OpenAI integration. Set AI_CHAT_MODEL=openai only when OPENAI_API_KEY is configured.
AI_CHAT_MODEL=none
OPENAI_API_KEY=disabled
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER_TIMEOUT=30s
AI_PROVIDER_MAX_RETRIES=0
# Exact comma-separated hostnames; HTTP tool also requires HTTPS and port 443.
HTTP_TOOL_ALLOWED_HOSTS=
AI_INPUT_USD_PER_1K_TOKENS=0
AI_OUTPUT_USD_PER_1K_TOKENS=0
